PageWrapperComponent: PageWrapper {
    title = "Home";
}

MembershipsLoop: WORepetition {
    list = session.currentPerson.memberships;
    item = membership;
}

MembershipContainer: WOGenericContainer {
    elementName = "div";
    class = sectionClass;
}

NotConfirmedCheck: WOConditional {
    condition = membership.confirmed;
    negate = true;
}

GroupNameString: WOString {
    value = membership.group.name;
}

GroupDescriptionCheck: WOConditional {
    condition = membership.group.description;
}

GroupDescriptionString: WOString {
    value = membership.group.description;
}

GroupOwnerNameString: WOString {
    value = membership.group.owner.name;
}

AcceptInvitationLink: WOHyperlink {
    action = acceptInvitation;
}

DeclineInvitationLink: WOHyperlink {
    action = declineInvitation;
}

ConfirmedCheck: WOConditional {
    condition = membership.confirmed;
}

GroupPageLink: ERXDataHyperlink {
    pageName = "SPGroupPage";
    group = membership.group;
}

GroupNameString2: WOString {
    value = membership.group.name;
}

GroupDescriptionCheck2: WOConditional {
    condition = membership.group.description;
}

GroupDescriptionString2: WOString {
    value = membership.group.description;
}

CanEditCheck: WOConditional {
    condition = canEdit;
}

GroupEditLink: ERXDataHyperlink {
    pageName = "SPGroupEditPage";
    group = membership.group;
}

EventsLoop: WORepetition {
    list = membership.group.events;
    item = event;
}

EventLink: ERXDataHyperlink {
    pageName = "SPEventPage";
    event = event;
}

EventNameString: WOString {
    value = event.name;
}

EventDescriptionCheck: WOConditional {
    condition = event.description;
}

EventDescriptionString: WOString {
    value = event.description;
}

ProfileLink: WOHyperlink {
    pageName = "SPProfilePage";
}

NewGroupLink: ERXDataHyperlink {
    pageName = "SPGroupNewPage";
}
PageWrapperComponent: PageWrapper {
    title = "Change Your Password";
    hideBreadcrumb = true;
}

PasswordForm: WOForm {
}

NotConfirmedCheck: WOConditional {
    condition = person.anyMembershipsConfirmed;
    negate = true;
}

NameField: WOTextField {
    value = person.name;
}

PasswordField: WOPasswordField {
    value = password;
}

ConfirmPasswordField: WOPasswordField {
    value = confirmPassword;
}

ResetPasswordButton: WOSubmitButton {
    action = resetPassword;
    value = "Change Your Password";
}

CancelLink: WOHyperlink {
    directActionName = "default";
}
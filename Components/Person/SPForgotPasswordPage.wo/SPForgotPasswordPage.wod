PageWrapperComponent: PageWrapper {
    title = "Forgot My Password";
    hideBreadcrumb = true;
}

ForgotForm: WOForm {
}

EmailField: WOTextField {
    value = emailAddress;
}

SendEmailButton: WOSubmitButton {
    action = sendEmail;
    value = "Reset My Password";
}

CancelLink: WOHyperlink {
    directActionName = "default";
}